{
	"$schema": "https://blockstudio.dev/schema/block",
	"apiVersion": 3,
	"name": "creationell-theme/post-accordion",
	"title": "Post accordion",
	"category": "creationell-theme",
	"icon": "excerpt-view",
	"description": "Posts as accordion or tabs, with the excerpt or the full content.",
	"keywords": [
		"posts",
		"accordion",
		"tabs",
		"faq"
	],
	"textdomain": "creationell-wp-theme",
	"supports": {
		"html": false,
		"anchor": true,
		"align": true
	},
	"example": {
		"attributes": {
			"display": "accordion",
			"postsPerPage": 3
		}
	},
	"blockstudio": {
		"attributes": [
			{
				"id": "display",
				"type": "select",
				"label": "Display",
				"default": "accordion",
				"options": [
					{
						"value": "accordion",
						"label": "Accordion"
					},
					{
						"value": "tabs",
						"label": "Tabs"
					}
				]
			},
			{
				"id": "openFirst",
				"type": "toggle",
				"label": "Open the first item",
				"default": true,
				"conditions": [
					[
						{
							"id": "display",
							"operator": "==",
							"value": "accordion"
						}
					]
				]
			},
			{
				"id": "alwaysOpen",
				"type": "toggle",
				"label": "Keep items open",
				"help": "Opening an item does not close the others.",
				"default": false,
				"conditions": [
					[
						{
							"id": "display",
							"operator": "==",
							"value": "accordion"
						}
					]
				]
			},
			{
				"id": "flush",
				"type": "toggle",
				"label": "Without outer borders",
				"default": false,
				"conditions": [
					[
						{
							"id": "display",
							"operator": "==",
							"value": "accordion"
						}
					]
				]
			},
			{
				"id": "contentMode",
				"type": "select",
				"label": "Text",
				"default": "excerpt",
				"options": [
					{
						"value": "excerpt",
						"label": "Excerpt"
					},
					{
						"value": "content",
						"label": "Full content"
					}
				]
			},
			{
				"id": "postType",
				"type": "select",
				"label": "Post type",
				"default": "post",
				"populate": {
					"type": "function",
					"function": "get_post_types",
					"arguments": [
						{
							"public": true
						},
						"objects"
					],
					"returnFormat": {
						"value": "name",
						"label": "label"
					}
				}
			},
			{
				"id": "taxonomy",
				"type": "select",
				"label": "Taxonomy",
				"help": "Shows only posts with one of the terms below.",
				"allowNull": true,
				"default": "",
				"populate": {
					"type": "function",
					"function": "get_taxonomies",
					"arguments": [
						{
							"public": true
						},
						"objects"
					],
					"returnFormat": {
						"value": "name",
						"label": "label"
					}
				}
			},
			{
				"id": "terms",
				"type": "text",
				"label": "Term IDs",
				"help": "IDs of the terms of the taxonomy, separated by commas.",
				"default": ""
			},
			{
				"id": "postIds",
				"type": "select",
				"multiple": true,
				"label": "Selected posts",
				"help": "Shows only these posts. Leave empty for the newest posts.",
				"default": [],
				"populate": {
					"type": "query",
					"query": "posts",
					"fetch": true,
					"arguments": {
						"post_type": "any",
						"numberposts": 20
					},
					"returnFormat": {
						"value": "id"
					}
				}
			},
			{
				"id": "parentId",
				"type": "select",
				"label": "Parent page",
				"help": "Shows only the child pages of this page.",
				"allowNull": true,
				"default": 0,
				"populate": {
					"type": "query",
					"query": "posts",
					"fetch": true,
					"arguments": {
						"post_type": "page",
						"numberposts": 20
					},
					"returnFormat": {
						"value": "id"
					}
				}
			},
			{
				"id": "orderBy",
				"type": "select",
				"label": "Order by",
				"default": "date",
				"options": [
					{
						"value": "date",
						"label": "Date"
					},
					{
						"value": "title",
						"label": "Title"
					},
					{
						"value": "menu_order",
						"label": "Menu order"
					},
					{
						"value": "modified",
						"label": "Last modified"
					},
					{
						"value": "rand",
						"label": "Random"
					},
					{
						"value": "post__in",
						"label": "Order of the selected posts"
					}
				]
			},
			{
				"id": "order",
				"type": "select",
				"label": "Direction",
				"default": "DESC",
				"options": [
					{
						"value": "DESC",
						"label": "Descending"
					},
					{
						"value": "ASC",
						"label": "Ascending"
					}
				]
			},
			{
				"id": "postsPerPage",
				"type": "number",
				"label": "Number of posts",
				"default": 6,
				"min": 1,
				"max": 20,
				"step": 1
			},
			{
				"id": "excludeCurrent",
				"type": "toggle",
				"label": "Leave out the current post",
				"default": true
			},
			{
				"id": "showImage",
				"type": "toggle",
				"label": "Show image",
				"default": true
			},
			{
				"id": "showCategories",
				"type": "toggle",
				"label": "Show categories",
				"default": true
			},
			{
				"id": "showMeta",
				"type": "toggle",
				"label": "Show date and author",
				"default": true
			},
			{
				"id": "showExcerpt",
				"type": "toggle",
				"label": "Show excerpt",
				"default": true
			},
			{
				"id": "showReadMore",
				"type": "toggle",
				"label": "Show read more",
				"default": true
			},
			{
				"id": "showTags",
				"type": "toggle",
				"label": "Show tags",
				"default": false
			},
			{
				"id": "headingLevel",
				"type": "select",
				"label": "Heading level",
				"help": "Level of the post titles, to fit the headings around the block.",
				"default": 3,
				"options": [
					{
						"value": 2,
						"label": "Heading 2"
					},
					{
						"value": 3,
						"label": "Heading 3"
					},
					{
						"value": 4,
						"label": "Heading 4"
					},
					{
						"value": 5,
						"label": "Heading 5"
					},
					{
						"value": 6,
						"label": "Heading 6"
					}
				]
			}
		]
	}
}
